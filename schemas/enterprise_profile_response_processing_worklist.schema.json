{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-profile-response-processing-worklist/1.0.0",
  "title": "Enterprise Profile Response Processing Worklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_processing_worklist_schema_version",
    "response_processing_worklist_id",
    "response_processing_worklist_content_hash",
    "enterprise",
    "source_dependencies",
    "processing_items",
    "processing_summary",
    "warnings",
    "generated_at_utc"
  ],
  "properties": {
    "response_processing_worklist_schema_version": {
      "const": "enterprise-profile-response-processing-worklist/1.0.0"
    },
    "response_processing_worklist_id": {
      "type": "string",
      "pattern": "^enterprise-profile-response-processing-worklist:.+:[0-9a-f]{16}$"
    },
    "response_processing_worklist_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enterprise": {
      "$ref": "#/$defs/enterprise"
    },
    "source_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_response_receipt_schema_version",
        "question_response_receipt_id",
        "question_response_receipt_content_hash",
        "question_response_submission_schema_version",
        "question_response_submission_id",
        "question_response_submission_content_hash",
        "question_plan_schema_version",
        "question_plan_id",
        "question_plan_content_hash",
        "question_plan_request_schema_version",
        "question_plan_request_id",
        "question_plan_request_content_hash",
        "gap_inventory_schema_version",
        "gap_inventory_id",
        "gap_inventory_content_hash",
        "gap_analysis_request_schema_version",
        "gap_analysis_request_id",
        "gap_analysis_request_content_hash",
        "fact_profile_schema_version",
        "fact_profile_content_hash",
        "capability_profile_schema_version",
        "capability_profile_id",
        "capability_profile_content_hash",
        "decision_profile_schema_version",
        "decision_profile_id",
        "decision_profile_content_hash"
      ],
      "properties": {
        "question_response_receipt_schema_version": {
          "const": "enterprise-profile-question-response-receipt/1.0.0"
        },
        "question_response_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "question_response_receipt_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question_response_submission_schema_version": {
          "const": "enterprise-profile-question-response-submission/1.0.0"
        },
        "question_response_submission_id": {
          "type": "string",
          "minLength": 1
        },
        "question_response_submission_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question_plan_schema_version": {
          "const": "enterprise-profile-question-plan/1.0.0"
        },
        "question_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "question_plan_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question_plan_request_schema_version": {
          "const": "enterprise-profile-question-plan-request/1.0.0"
        },
        "question_plan_request_id": {
          "type": "string",
          "minLength": 1
        },
        "question_plan_request_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gap_inventory_schema_version": {
          "const": "enterprise-profile-gap-inventory/1.0.0"
        },
        "gap_inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "gap_inventory_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gap_analysis_request_schema_version": {
          "const": "enterprise-profile-gap-analysis-request/1.0.0"
        },
        "gap_analysis_request_id": {
          "type": "string",
          "minLength": 1
        },
        "gap_analysis_request_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fact_profile_schema_version": {
          "const": "enterprise-fact-profile/1.3.0"
        },
        "fact_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_profile_schema_version": {
          "enum": [
            "enterprise-capability-profile/1.1.0",
            "enterprise-capability-profile/1.2.0"
          ]
        },
        "capability_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_profile_schema_version": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "enterprise-decision-profile/1.0.0",
            null
          ]
        },
        "decision_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_profile_content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "processing_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processingItem"
      }
    },
    "processing_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_response_item_count",
        "processing_item_count",
        "decision_update_candidate_ready_count",
        "evidence_processing_required_count",
        "conflict_review_required_count",
        "capability_review_required_count",
        "unavailable_recorded_count",
        "response_with_material_count",
        "unique_material_count",
        "decision_update_candidate_count",
        "pending_processing_count",
        "has_pending_processing"
      ],
      "properties": {
        "recorded_response_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "processing_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_update_candidate_ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_processing_required_count": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_review_required_count": {
          "type": "integer",
          "minimum": 0
        },
        "capability_review_required_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_recorded_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_with_material_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_material_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_update_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_processing_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_pending_processing": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unified_social_credit_code",
        "internal_enterprise_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unified_social_credit_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal_enterprise_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "materialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "material_content_sha256",
        "original_filename",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "material_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_filename": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "media_type": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "decisionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_schema_version",
        "candidate_id",
        "candidate_content_hash",
        "candidate_type",
        "target_field",
        "base_decision_profile_id",
        "base_decision_profile_content_hash",
        "confirmation_input",
        "candidate_status"
      ],
      "properties": {
        "candidate_schema_version": {
          "const": "enterprise-decision-profile-update-candidate/1.0.0"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^enterprise-decision-profile-update-candidate:.+:[0-9a-f]{24}$"
        },
        "candidate_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_type": {
          "const": "decision_confirmation_input"
        },
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "base_decision_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_decision_profile_content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmation_input": {
          "type": "object"
        },
        "candidate_status": {
          "const": "ready_for_decision_profile_update"
        }
      }
    },
    "processingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_item_id",
        "processing_item_content_hash",
        "response_item_id",
        "response_item_content_hash",
        "question_item_id",
        "question_item_content_hash",
        "gap_id",
        "gap_content_hash",
        "requirement_id",
        "target_layer",
        "target_code",
        "importance",
        "response_outcome",
        "information_request_type",
        "processing_status",
        "required_actions",
        "material_references",
        "decision_update_candidate"
      ],
      "properties": {
        "processing_item_id": {
          "type": "string",
          "pattern": "^enterprise-profile-response-processing-item:(fact|capability|decision):[0-9a-f]{24}$"
        },
        "processing_item_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_item_id": {
          "type": "string",
          "minLength": 1
        },
        "response_item_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question_item_id": {
          "type": "string",
          "minLength": 1
        },
        "question_item_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "gap_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "target_layer": {
          "enum": [
            "fact",
            "capability",
            "decision"
          ]
        },
        "target_code": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "enum": [
            "blocking",
            "important",
            "optional"
          ]
        },
        "response_outcome": {
          "enum": [
            "provided",
            "unable_to_provide"
          ]
        },
        "information_request_type": {
          "enum": [
            "decision_confirmation",
            "supporting_material",
            "fact_verification",
            "conflict_clarification",
            "capability_clarification"
          ]
        },
        "processing_status": {
          "enum": [
            "decision_update_candidate_ready",
            "evidence_processing_required",
            "conflict_review_required",
            "capability_review_required",
            "unavailable_recorded"
          ]
        },
        "required_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "record_unavailable_declaration",
              "no_profile_update",
              "prepare_decision_profile_update",
              "review_structured_response",
              "process_material_references",
              "verify_before_profile_update",
              "verify_fact_before_profile_update",
              "review_conflict_selection",
              "resolve_conflict_before_profile_update",
              "review_capability_clarification",
              "review_before_capability_update"
            ]
          }
        },
        "material_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/materialReference"
          }
        },
        "decision_update_candidate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/decisionCandidate"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "processing_status": {
                "const": "decision_update_candidate_ready"
              }
            },
            "required": [
              "processing_status"
            ]
          },
          "then": {
            "properties": {
              "decision_update_candidate": {
                "$ref": "#/$defs/decisionCandidate"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "processing_status": {
                  "const": "decision_update_candidate_ready"
                }
              },
              "required": [
                "processing_status"
              ]
            }
          },
          "then": {
            "properties": {
              "decision_update_candidate": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
