{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-capability-profile/1.2.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observation_type",
        "observation_value",
        "support_status",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_type": {
          "type": "string",
          "minLength": 1
        },
        "observation_value": {},
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_type",
        "capability_subject",
        "capability_value",
        "support_status",
        "derivation_method",
        "basis_summary",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations",
        "time_scope"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_type": {
          "enum": [
            "industry_capability",
            "technical_capability",
            "similar_performance_capability",
            "regional_delivery_capability",
            "amount_experience_capability",
            "personnel_resource_capability",
            "buyer_relationship_capability",
            "tender_performance_capability"
          ]
        },
        "capability_subject": {
          "type": "string",
          "minLength": 1
        },
        "capability_value": {},
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "derivation_method": {
          "enum": [
            "deterministic_aggregation",
            "deterministic_rule",
            "semantic_inference"
          ]
        },
        "basis_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of_date"
          ],
          "properties": {
            "as_of_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_run_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "review_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "review_content_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "derivation_method": {
                "const": "semantic_inference"
              }
            },
            "required": [
              "derivation_method"
            ]
          },
          "then": {
            "required": [
              "source_candidate_id",
              "source_candidate_content_hash",
              "semantic_analysis_run_id",
              "semantic_analysis_content_hash",
              "review_batch_id",
              "review_content_hash"
            ],
            "properties": {
              "source_candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "source_candidate_content_hash": {
                "type": "string",
                "minLength": 1
              },
              "semantic_analysis_run_id": {
                "type": "string",
                "minLength": 1
              },
              "semantic_analysis_content_hash": {
                "type": "string",
                "minLength": 1
              },
              "review_batch_id": {
                "type": "string",
                "minLength": 1
              },
              "review_content_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation_method": {
                "enum": [
                  "deterministic_aggregation",
                  "deterministic_rule"
                ]
              }
            },
            "required": [
              "derivation_method"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source_candidate_id"
                  ]
                },
                {
                  "required": [
                    "source_candidate_content_hash"
                  ]
                },
                {
                  "required": [
                    "semantic_analysis_run_id"
                  ]
                },
                {
                  "required": [
                    "semantic_analysis_content_hash"
                  ]
                },
                {
                  "required": [
                    "review_batch_id"
                  ]
                },
                {
                  "required": [
                    "review_content_hash"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "required_data"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_type",
        "capability_name",
        "support_status",
        "observations",
        "capability_claims",
        "semantic_capability_candidates",
        "unknowns",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations",
        "reviewed_semantic_observations"
      ],
      "properties": {
        "capability_type": {
          "enum": [
            "industry_capability",
            "technical_capability",
            "similar_performance_capability",
            "regional_delivery_capability",
            "amount_experience_capability",
            "personnel_resource_capability",
            "buyer_relationship_capability",
            "tender_performance_capability"
          ]
        },
        "capability_name": {
          "type": "string",
          "minLength": 1
        },
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "capability_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "semantic_capability_candidates": {
          "type": "array",
          "maxItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_semantic_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewedSemanticObservation"
          }
        }
      }
    },
    "reviewedSemanticObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_observation_id",
        "capability_type",
        "candidate_kind",
        "observation_subject",
        "observation_value",
        "inference_summary",
        "support_status",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations",
        "unknowns",
        "source_candidate_id",
        "source_candidate_content_hash",
        "semantic_analysis_run_id",
        "semantic_analysis_content_hash",
        "review_batch_id",
        "review_content_hash"
      ],
      "properties": {
        "semantic_observation_id": {
          "type": "string",
          "pattern": "^semantic-observation:[a-z_]+:[0-9a-f]{24}$"
        },
        "capability_type": {
          "enum": [
            "industry_capability",
            "technical_capability",
            "similar_performance_capability",
            "regional_delivery_capability",
            "amount_experience_capability",
            "personnel_resource_capability",
            "buyer_relationship_capability",
            "tender_performance_capability"
          ]
        },
        "candidate_kind": {
          "type": "string",
          "minLength": 1
        },
        "observation_subject": {
          "type": "string",
          "minLength": 1
        },
        "observation_value": {
          "type": "object"
        },
        "inference_summary": {
          "type": "string",
          "minLength": 1
        },
        "support_status": {
          "const": "ambiguous"
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_run_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "review_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "review_content_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "capability_profile_schema_version",
    "capability_profile_id",
    "capability_content_hash",
    "enterprise",
    "as_of_date",
    "fact_view_mode",
    "source_dependencies",
    "generation",
    "capability_domains",
    "capability_summary",
    "evidence_index",
    "warnings",
    "data_quality_summary",
    "generated_at_utc",
    "semantic_review_summary",
    "capability_gap_summary"
  ],
  "properties": {
    "capability_profile_schema_version": {
      "const": "enterprise-capability-profile/1.2.0"
    },
    "capability_profile_id": {
      "type": "string",
      "pattern": "^capability-profile:.+:[0-9a-f]{16}$"
    },
    "capability_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unified_social_credit_code",
        "internal_enterprise_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unified_social_credit_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal_enterprise_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "as_of_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fact_view_mode": {
      "enum": [
        "as_of",
        "all_known_facts"
      ]
    },
    "capability_domains": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "evidence_index": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_summary": {
      "type": "object"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_profile_schema_version",
        "fact_profile_content_hash",
        "tag_profile_schema_version",
        "tag_profile_content_hash",
        "previous_capability_profile_id",
        "previous_capability_content_hash",
        "semantic_candidates_schema_version",
        "semantic_analysis_run_id",
        "semantic_analysis_content_hash",
        "candidate_review_schema_version",
        "candidate_review_content_hash",
        "evidence_policy_version"
      ],
      "properties": {
        "fact_profile_schema_version": {
          "const": "enterprise-fact-profile/1.3.0"
        },
        "fact_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tag_profile_schema_version": {
          "const": "enterprise-profile-tags/1.1.0"
        },
        "tag_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_capability_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_capability_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_candidates_schema_version": {
          "const": "enterprise-capability-semantic-candidates/1.1.0"
        },
        "semantic_analysis_run_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_review_schema_version": {
          "const": "enterprise-capability-candidate-review/1.0.0"
        },
        "candidate_review_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_policy_version": {
          "const": "enterprise-capability-evidence-policy/1.0.0"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_mode",
        "deterministic_engine_version",
        "semantic_analysis_status"
      ],
      "properties": {
        "generation_mode": {
          "const": "reviewed_capability_update"
        },
        "deterministic_engine_version": {
          "const": "capability-deterministic-v1.1"
        },
        "semantic_analysis_status": {
          "enum": [
            "partially_reviewed",
            "reviewed"
          ]
        }
      }
    },
    "capability_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_domain_count",
        "supported_domain_count",
        "partially_supported_domain_count",
        "ambiguous_domain_count",
        "insufficient_data_domain_count",
        "deterministic_claim_count",
        "reviewed_semantic_claim_count",
        "reviewed_semantic_observation_count",
        "total_formal_claim_count",
        "semantic_candidate_count"
      ],
      "properties": {
        "supported_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "partially_supported_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_data_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_semantic_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_semantic_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_formal_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_domain_count": {
          "const": 8
        },
        "semantic_candidate_count": {
          "const": 0
        }
      }
    },
    "semantic_review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_analysis_run_id",
        "semantic_analysis_content_hash",
        "review_batch_id",
        "review_content_hash",
        "review_scope",
        "total_candidate_count",
        "approved_candidate_count",
        "approved_claim_count",
        "approved_observation_count",
        "rejected_candidate_count",
        "needs_more_evidence_count",
        "pending_candidate_count",
        "merge_outcomes"
      ],
      "properties": {
        "semantic_analysis_run_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_analysis_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_batch_id": {
          "type": "string",
          "pattern": "^capability-review-batch:[0-9a-f]{24}$"
        },
        "review_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_scope": {
          "enum": [
            "partial",
            "full"
          ]
        },
        "total_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "approved_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "approved_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "approved_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "needs_more_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "merge_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "outcome_code"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "outcome_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "capability_gap_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_more_evidence_count",
        "items"
      ],
      "properties": {
        "needs_more_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "capability_type",
              "reason_code",
              "reason_summary"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "capability_type": {
                "enum": [
                  "industry_capability",
                  "technical_capability",
                  "similar_performance_capability",
                  "regional_delivery_capability",
                  "amount_experience_capability",
                  "personnel_resource_capability",
                  "buyer_relationship_capability",
                  "tender_performance_capability"
                ]
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              },
              "reason_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
