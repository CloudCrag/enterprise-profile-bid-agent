{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-profile-question-response-submission/1.0.0",
  "title": "Enterprise Profile Question Response Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_response_submission_schema_version",
    "question_response_submission_id",
    "question_response_submission_content_hash",
    "enterprise",
    "question_plan_id",
    "question_plan_content_hash",
    "submission_mode",
    "submitted_by",
    "submitted_at_utc",
    "response_items",
    "generated_at_utc"
  ],
  "properties": {
    "question_response_submission_schema_version": {"const": "enterprise-profile-question-response-submission/1.0.0"},
    "question_response_submission_id": {"type": "string", "minLength": 1},
    "question_response_submission_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enterprise": {"$ref": "#/$defs/enterprise"},
    "question_plan_id": {"type": "string", "minLength": 1},
    "question_plan_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "submission_mode": {"enum": ["partial_current_batch", "full_current_batch"]},
    "submitted_by": {"$ref": "#/$defs/submittedBy"},
    "submitted_at_utc": {"type": "string", "format": "date-time"},
    "response_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/responseItem"}},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "enterprise": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unified_social_credit_code", "internal_enterprise_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unified_social_credit_code": {"type": ["string", "null"]},
        "internal_enterprise_id": {"type": ["string", "null"]}
      }
    },
    "submittedBy": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_type", "actor_id", "display_name"],
      "properties": {
        "actor_type": {"const": "user"},
        "actor_id": {"type": "string", "pattern": ".*\\S.*"},
        "display_name": {"type": ["string", "null"], "pattern": ".*\\S.*"}
      }
    },
    "materialReference": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "material_content_sha256", "original_filename", "media_type", "size_bytes"],
      "properties": {
        "material_id": {"type": "string", "pattern": ".*\\S.*"},
        "material_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "original_filename": {"type": "string", "pattern": ".*\\S.*"},
        "media_type": {"type": "string", "pattern": ".*\\S.*"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "decisionConfirmationAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_type", "decision_confirmation_input"],
      "properties": {
        "answer_type": {"const": "decision_confirmation"},
        "decision_confirmation_input": {"type": "object"}
      }
    },
    "structuredValueAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_type", "value", "user_note"],
      "properties": {
        "answer_type": {"const": "structured_value"},
        "value": {"type": ["string", "number", "boolean", "object", "array"]},
        "user_note": {"type": ["string", "null"], "pattern": ".*\\S.*"}
      }
    },
    "conflictSelectionAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_type", "selected_source_reference_ids", "selection_note"],
      "properties": {
        "answer_type": {"const": "conflict_selection"},
        "selected_source_reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_note": {"type": ["string", "null"], "pattern": ".*\\S.*"}
      }
    },
    "clarificationAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_type", "clarification_text", "structured_context"],
      "properties": {
        "answer_type": {"const": "clarification"},
        "clarification_text": {"type": "string", "pattern": ".*\\S.*"},
        "structured_context": {"type": ["object", "null"]}
      }
    },
    "answer": {
      "oneOf": [
        {"$ref": "#/$defs/decisionConfirmationAnswer"},
        {"$ref": "#/$defs/structuredValueAnswer"},
        {"$ref": "#/$defs/conflictSelectionAnswer"},
        {"$ref": "#/$defs/clarificationAnswer"}
      ]
    },
    "responseItem": {
      "type": "object", "additionalProperties": false,
      "required": [
        "response_item_id", "response_item_content_hash",
        "question_item_id", "question_item_content_hash",
        "gap_id", "gap_content_hash", "requirement_id", "target_layer", "target_code",
        "response_outcome", "answer", "material_references",
        "unable_to_provide_note", "response_status"
      ],
      "properties": {
        "response_item_id": {"type": "string", "minLength": 1},
        "response_item_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "question_item_id": {"type": "string", "minLength": 1},
        "question_item_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gap_id": {"type": "string", "minLength": 1},
        "gap_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirement_id": {"type": "string", "minLength": 1},
        "target_layer": {"enum": ["fact", "capability", "decision"]},
        "target_code": {"type": "string", "minLength": 1},
        "response_outcome": {"enum": ["provided", "unable_to_provide"]},
        "answer": {"oneOf": [{"$ref": "#/$defs/answer"}, {"type": "null"}]},
        "material_references": {"type": "array", "items": {"$ref": "#/$defs/materialReference"}},
        "unable_to_provide_note": {"type": ["string", "null"], "pattern": ".*\\S.*"},
        "response_status": {"const": "submitted"}
      }
    }
  }
}
