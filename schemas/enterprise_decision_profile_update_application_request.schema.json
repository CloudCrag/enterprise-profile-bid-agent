{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-decision-profile-update-application-request/1.0.0",
  "title": "Enterprise Decision Profile Update Application Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_request_schema_version",
    "application_request_id",
    "application_request_content_hash",
    "enterprise",
    "response_processing_worklist_id",
    "response_processing_worklist_content_hash",
    "selected_candidate_ids",
    "requested_at_utc",
    "generated_at_utc"
  ],
  "properties": {
    "application_request_schema_version": {"const": "enterprise-decision-profile-update-application-request/1.0.0"},
    "application_request_id": {"type": "string", "pattern": "^enterprise-decision-profile-update-application-request:.+:[0-9a-f]{16}$"},
    "application_request_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enterprise": {"type": "object", "minProperties": 1},
    "response_processing_worklist_id": {"type": "string", "minLength": 1},
    "response_processing_worklist_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^enterprise-decision-profile-update-candidate:.+:[0-9a-f]{24}$"}
    },
    "requested_at_utc": {"type": "string", "format": "date-time"},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  }
}
