{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-capability-candidate-review/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_review_schema_version", "review_batch_id", "review_content_hash", "enterprise", "as_of_date",
    "source_dependencies", "review_actor", "review_scope", "decisions", "review_summary", "generated_at_utc"
  ],
  "properties": {
    "candidate_review_schema_version": {"const": "enterprise-capability-candidate-review/1.0.0"},
    "review_batch_id": {"type": "string", "pattern": "^capability-review-batch:[0-9a-f]{24}$"},
    "review_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enterprise": {"type": "object"},
    "as_of_date": {"type": ["string", "null"], "format": "date"},
    "source_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_candidates_schema_version", "semantic_analysis_run_id", "semantic_analysis_content_hash",
        "capability_profile_schema_version", "capability_profile_id", "capability_content_hash",
        "fact_profile_schema_version", "fact_profile_content_hash",
        "tag_profile_schema_version", "tag_profile_content_hash", "evidence_policy_version"
      ],
      "properties": {
        "semantic_candidates_schema_version": {"const": "enterprise-capability-semantic-candidates/1.1.0"},
        "semantic_analysis_run_id": {"type": "string", "minLength": 1},
        "semantic_analysis_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_profile_schema_version": {
          "enum": ["enterprise-capability-profile/1.1.0", "enterprise-capability-profile/1.2.0"]
        },
        "capability_profile_id": {"type": "string", "minLength": 1},
        "capability_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fact_profile_schema_version": {"const": "enterprise-fact-profile/1.3.0"},
        "fact_profile_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tag_profile_schema_version": {"const": "enterprise-profile-tags/1.1.0"},
        "tag_profile_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_policy_version": {"const": "enterprise-capability-evidence-policy/1.0.0"}
      }
    },
    "review_actor": {
      "type": "object", "additionalProperties": false, "required": ["actor_type", "actor_id"],
      "properties": {"actor_type": {"const": "human"}, "actor_id": {"type": "string", "pattern": ".*\\S.*"}}
    },
    "review_scope": {"enum": ["partial", "full"]},
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "candidate_content_hash", "decision", "reason_code", "reason_summary"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^semantic-candidate:[a-z_]+:[0-9a-f]{24}$"},
          "candidate_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision": {"enum": ["approved", "rejected", "needs_more_evidence"]},
          "reason_code": {"type": "string", "minLength": 1},
          "reason_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total_candidate_count", "reviewed_candidate_count", "approved_candidate_count", "rejected_candidate_count", "needs_more_evidence_count", "pending_candidate_count"],
      "properties": {
        "total_candidate_count": {"type": "integer", "minimum": 0},
        "reviewed_candidate_count": {"type": "integer", "minimum": 0},
        "approved_candidate_count": {"type": "integer", "minimum": 0},
        "rejected_candidate_count": {"type": "integer", "minimum": 0},
        "needs_more_evidence_count": {"type": "integer", "minimum": 0},
        "pending_candidate_count": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at_utc": {"type": "string", "format": "date-time"}
  }
}
