{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-capability-profile/1.1.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observation_type",
        "observation_value",
        "support_status",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_type": {
          "type": "string",
          "minLength": 1
        },
        "observation_value": {},
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_type",
        "capability_subject",
        "capability_value",
        "support_status",
        "derivation_method",
        "basis_summary",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations",
        "time_scope"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_type": {
          "enum": [
            "industry_capability",
            "technical_capability",
            "similar_performance_capability",
            "regional_delivery_capability",
            "amount_experience_capability",
            "personnel_resource_capability",
            "buyer_relationship_capability",
            "tender_performance_capability"
          ]
        },
        "capability_subject": {
          "type": "string",
          "minLength": 1
        },
        "capability_value": {},
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "derivation_method": {
          "enum": [
            "deterministic_aggregation",
            "deterministic_rule"
          ]
        },
        "basis_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of_date"
          ],
          "properties": {
            "as_of_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "required_data"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_type",
        "capability_name",
        "support_status",
        "observations",
        "capability_claims",
        "semantic_capability_candidates",
        "unknowns",
        "source_fact_ids",
        "source_tag_codes",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "capability_type": {
          "enum": [
            "industry_capability",
            "technical_capability",
            "similar_performance_capability",
            "regional_delivery_capability",
            "amount_experience_capability",
            "personnel_resource_capability",
            "buyer_relationship_capability",
            "tender_performance_capability"
          ]
        },
        "capability_name": {
          "type": "string",
          "minLength": 1
        },
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous",
            "insufficient_data"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "capability_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "semantic_capability_candidates": {
          "type": "array",
          "maxItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_tag_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "capability_profile_schema_version",
    "capability_profile_id",
    "capability_content_hash",
    "enterprise",
    "as_of_date",
    "fact_view_mode",
    "source_dependencies",
    "generation",
    "capability_domains",
    "capability_summary",
    "evidence_index",
    "warnings",
    "data_quality_summary",
    "generated_at_utc"
  ],
  "properties": {
    "capability_profile_schema_version": {
      "const": "enterprise-capability-profile/1.1.0"
    },
    "capability_profile_id": {
      "type": "string",
      "pattern": "^capability-profile:.+:[0-9a-f]{16}$"
    },
    "capability_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unified_social_credit_code",
        "internal_enterprise_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unified_social_credit_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal_enterprise_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "as_of_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fact_view_mode": {
      "enum": [
        "as_of",
        "all_known_facts"
      ]
    },
    "capability_domains": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "evidence_index": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_summary": {
      "type": "object"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_profile_schema_version",
        "fact_profile_content_hash",
        "tag_profile_schema_version",
        "tag_profile_content_hash"
      ],
      "properties": {
        "fact_profile_schema_version": {
          "const": "enterprise-fact-profile/1.3.0"
        },
        "fact_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tag_profile_schema_version": {
          "const": "enterprise-profile-tags/1.1.0"
        },
        "tag_profile_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_mode",
        "deterministic_engine_version",
        "semantic_analysis_status"
      ],
      "properties": {
        "generation_mode": {
          "const": "deterministic_baseline"
        },
        "deterministic_engine_version": {
          "const": "capability-deterministic-v1.1"
        },
        "semantic_analysis_status": {
          "const": "not_run"
        }
      }
    },
    "capability_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_domain_count",
        "supported_domain_count",
        "partially_supported_domain_count",
        "ambiguous_domain_count",
        "insufficient_data_domain_count",
        "deterministic_claim_count",
        "semantic_candidate_count"
      ],
      "properties": {
        "supported_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "partially_supported_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_data_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_domain_count": {
          "const": 8
        },
        "semantic_candidate_count": {
          "const": 0
        }
      }
    }
  }
}
