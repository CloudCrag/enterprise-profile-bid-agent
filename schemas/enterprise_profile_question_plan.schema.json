{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-profile-question-plan/1.0.0",
  "title": "Enterprise Profile Question Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_plan_schema_version", "question_plan_id", "question_plan_content_hash",
    "enterprise", "source_dependencies", "planning_options", "plan_status",
    "question_items", "deferred_required_gaps", "excluded_optional_gaps",
    "plan_summary", "warnings", "generated_at_utc"
  ],
  "properties": {
    "question_plan_schema_version": {"const": "enterprise-profile-question-plan/1.0.0"},
    "question_plan_id": {"type": "string", "minLength": 1},
    "question_plan_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enterprise": {"$ref": "#/$defs/enterprise"},
    "source_dependencies": {"$ref": "#/$defs/sourceDependencies"},
    "planning_options": {"$ref": "#/$defs/planningOptions"},
    "plan_status": {"enum": ["questions_planned", "required_gaps_complete", "no_gaps"]},
    "question_items": {"type": "array", "items": {"$ref": "#/$defs/questionItem"}},
    "deferred_required_gaps": {"type": "array", "items": {"$ref": "#/$defs/deferredRequired"}},
    "excluded_optional_gaps": {"type": "array", "items": {"$ref": "#/$defs/excludedOptional"}},
    "plan_summary": {"$ref": "#/$defs/planSummary"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "enterprise": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unified_social_credit_code", "internal_enterprise_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unified_social_credit_code": {"type": ["string", "null"]},
        "internal_enterprise_id": {"type": ["string", "null"]}
      }
    },
    "planningOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["max_questions_per_batch", "include_optional"],
      "properties": {
        "max_questions_per_batch": {"type": "integer", "minimum": 1},
        "include_optional": {"type": "boolean"}
      }
    },
    "sourceDependencies": {
      "type": "object", "additionalProperties": false,
      "required": [
        "question_plan_request_schema_version", "question_plan_request_id", "question_plan_request_content_hash",
        "gap_inventory_schema_version", "gap_inventory_id", "gap_inventory_content_hash",
        "gap_analysis_request_schema_version", "gap_analysis_request_id", "gap_analysis_request_content_hash",
        "fact_profile_schema_version", "fact_profile_content_hash",
        "capability_profile_schema_version", "capability_profile_id", "capability_profile_content_hash",
        "decision_profile_schema_version", "decision_profile_id", "decision_profile_content_hash"
      ],
      "properties": {
        "question_plan_request_schema_version": {"const": "enterprise-profile-question-plan-request/1.0.0"},
        "question_plan_request_id": {"type": "string", "minLength": 1},
        "question_plan_request_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gap_inventory_schema_version": {"const": "enterprise-profile-gap-inventory/1.0.0"},
        "gap_inventory_id": {"type": "string", "minLength": 1},
        "gap_inventory_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gap_analysis_request_schema_version": {"const": "enterprise-profile-gap-analysis-request/1.0.0"},
        "gap_analysis_request_id": {"type": "string", "minLength": 1},
        "gap_analysis_request_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fact_profile_schema_version": {"const": "enterprise-fact-profile/1.3.0"},
        "fact_profile_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_profile_schema_version": {"enum": ["enterprise-capability-profile/1.1.0", "enterprise-capability-profile/1.2.0"]},
        "capability_profile_id": {"type": "string", "minLength": 1},
        "capability_profile_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_profile_schema_version": {"type": ["string", "null"], "enum": ["enterprise-decision-profile/1.0.0", null]},
        "decision_profile_id": {"type": ["string", "null"]},
        "decision_profile_content_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "expectedResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["response_mode", "target_schema_reference", "material_allowed", "confirmation_required"],
      "properties": {
        "response_mode": {"enum": ["structured_value", "material", "structured_value_or_material", "conflict_selection", "clarification"]},
        "target_schema_reference": {"type": ["string", "null"]},
        "material_allowed": {"type": "boolean"},
        "confirmation_required": {"type": "boolean"}
      }
    },
    "questionItem": {
      "type": "object", "additionalProperties": false,
      "required": [
        "question_item_id", "question_item_content_hash", "gap_id", "gap_content_hash",
        "requirement_id", "target_layer", "target_code", "importance", "gap_status",
        "reason_code", "resolution_type", "information_request_type", "expected_response",
        "question_status", "prompt_template_key"
      ],
      "properties": {
        "question_item_id": {"type": "string", "minLength": 1},
        "question_item_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gap_id": {"type": "string", "minLength": 1},
        "gap_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirement_id": {"type": "string", "minLength": 1},
        "target_layer": {"enum": ["fact", "capability", "decision"]},
        "target_code": {"type": "string", "minLength": 1},
        "importance": {"enum": ["blocking", "important", "optional"]},
        "gap_status": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "resolution_type": {"enum": ["user_confirmation_required", "verified_fact_required", "supporting_material_required", "conflict_review_required", "capability_review_required"]},
        "information_request_type": {"enum": ["decision_confirmation", "supporting_material", "fact_verification", "conflict_clarification", "capability_clarification"]},
        "expected_response": {"$ref": "#/$defs/expectedResponse"},
        "question_status": {"const": "planned"},
        "prompt_template_key": {"type": "string", "minLength": 1}
      }
    },
    "deferredRequired": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "gap_content_hash", "requirement_id", "target_layer", "target_code", "importance", "defer_reason"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "gap_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirement_id": {"type": "string", "minLength": 1},
        "target_layer": {"enum": ["fact", "capability", "decision"]},
        "target_code": {"type": "string", "minLength": 1},
        "importance": {"enum": ["blocking", "important"]},
        "defer_reason": {"const": "batch_limit"}
      }
    },
    "excludedOptional": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "gap_content_hash", "requirement_id", "target_layer", "target_code", "importance", "exclude_reason"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "gap_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirement_id": {"type": "string", "minLength": 1},
        "target_layer": {"enum": ["fact", "capability", "decision"]},
        "target_code": {"type": "string", "minLength": 1},
        "importance": {"const": "optional"},
        "exclude_reason": {"enum": ["optional_not_requested", "batch_limit_optional"]}
      }
    },
    "planSummary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total_gap_count", "required_gap_count", "optional_gap_count", "selected_question_count",
        "selected_blocking_count", "selected_important_count", "selected_optional_count",
        "deferred_required_count", "excluded_optional_count", "has_more_required_gaps"
      ],
      "properties": {
        "total_gap_count": {"type": "integer", "minimum": 0},
        "required_gap_count": {"type": "integer", "minimum": 0},
        "optional_gap_count": {"type": "integer", "minimum": 0},
        "selected_question_count": {"type": "integer", "minimum": 0},
        "selected_blocking_count": {"type": "integer", "minimum": 0},
        "selected_important_count": {"type": "integer", "minimum": 0},
        "selected_optional_count": {"type": "integer", "minimum": 0},
        "deferred_required_count": {"type": "integer", "minimum": 0},
        "excluded_optional_count": {"type": "integer", "minimum": 0},
        "has_more_required_gaps": {"type": "boolean"}
      }
    }
  }
}
