        "semantic_status": {
          "enum": [
            "confirmed",
            "ambiguous",
            "unknown"
          ]
        },
        "normalization_status": {
          "enum": [
            "normalized",
            "missing_unit",
            "missing_currency",
            "inconsistent",
            "not_normalized"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "normalization_status": {
                "const": "normalized"
              }
            },
            "required": [
              "normalization_status"
            ]
          },
          "then": {
            "properties": {
              "normalized_value": {
                "type": "number"
              },
              "normalized_unit": {
                "type": "string",
                "minLength": 1
              },
              "normalized_currency": {
                "type": "string",
                "minLength": 1
              },
              "value_parse_status": {
