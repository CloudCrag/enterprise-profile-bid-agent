        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "materialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "material_content_sha256",
        "original_filename",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "material_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:\\.\\.[/\\\\]|[/\\\\]|^[A-Za-z]:)).+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
