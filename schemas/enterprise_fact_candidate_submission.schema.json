{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-fact-candidate-submission/1.0.0",
  "title": "Enterprise Fact Candidate Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "company_id",
    "source_type",
    "source_system",
    "source_record_id",
    "source_url",
    "collected_at",
    "fact_type",
    "payload",
    "material_refs",
    "submitted_by",
    "idempotency_key"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "crawler",
        "external_data",
        "legacy_excel",
        "manual_review",
        "official_api",
        "user_upload"
      ]
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "fact_type": {
      "enum": [
        "bid_award",
        "bid_participation",
        "business_registration",
        "buyer_relationship",
        "enterprise_material",
        "fulfillment",
        "other_enterprise_fact",
        "performance",
        "personnel",
        "personnel_certificate",
        "qualification",
        "risk_penalty_credit"
      ]
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    },
    "material_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/materialReference"
      }
    },
    "submitted_by": {
      "$ref": "#/$defs/actor"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_response_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_mock": {
      "type": "boolean"
    },
    "normalizer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trust_policy": {
      "enum": [
        "REVIEW_REQUIRED",
        "AUTO_VERIFIED",
        "SAMPLE_REVIEW",
        "REJECTED_SOURCE"
      ]
    }
  },
