# Windows 本机运行配置。复制为 .env.local 后填写真实值。
# .env.local 不得提交或放入交付 ZIP。

# 唯一允许的业务数据/模型模式
AGENT_DATA_PROVIDER=real
CAPABILITY_AI_PROVIDER=zhipu
CAPABILITY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CAPABILITY_AI_MODEL=
CAPABILITY_AI_API_KEY=
CAPABILITY_AI_TIMEOUT_SECONDS=180
CAPABILITY_AI_MAX_RETRIES=2
CAPABILITY_AI_MAX_RESPONSE_BYTES=1048576
CAPABILITY_AI_TEMPERATURE=0
CAPABILITY_AI_MAX_TOKENS=4096

# 通过用户手工建立的 SSH 隧道访问远程 MySQL。
# 示例：mysql://用户名:URL编码后的密码@127.0.0.1:13306/project_recommendation
REAL_DATABASE_URL=

# 本地运行数据
RUNTIME_DATA_ROOT=runtime_data
COMPETITION_DEMO_PATH=runtime_data/competition_demo/competitors.json
AGENT_CHECKPOINT_DB_PATH=runtime_data/checkpoints/agent.sqlite

# 本机服务地址
PROFILE_ADAPTER_NODE_URL=http://127.0.0.1:3000
PROFILE_SERVICE_URL=http://127.0.0.1:8000
BID_DECISION_SERVICE_URL=http://127.0.0.1:8001
API_PORT=3000
WEB_PORT=5173

# 本机调用超时
AGENT_GATEWAY_TIMEOUT_SECONDS=15
PROFILE_AGENT_TIMEOUT_MS=120000
BID_AGENT_TIMEOUT_MS=600000
UPSTREAM_TIMEOUT_MS=15000
